[
  {
    "name": "1-kvm-boot",
    "cmd": [
      "{python}",
      "scripts/test-desktop-guest.py",
      "--iso",
      "{isomain}",
      "--accel",
      "kvm"
    ],
    "env": {
      "ZEHOS_QEMU_SMP": "1"
    },
    "timeout": 1800,
    "note": "Boot bis Desktop"
  },
  {
    "name": "1-kvm-thread",
    "cmd": [
      "{python}",
      "scripts/test-thread-probe.py",
      "--iso",
      "{isothread}",
      "--accel",
      "kvm"
    ],
    "env": {
      "ZEHOS_QEMU_SMP": "1"
    },
    "timeout": 1800,
    "note": "THREAD_PROBE und MESSAGES_PROBE (SMP_PROBE folgt mit E7-A bis E7-D)"
  },
  {
    "name": "1-kvm-smp",
    "cmd": [
      "{python}",
      "scripts/test-smp-probe.py",
      "--iso",
      "{isosmp}",
      "--accel",
      "kvm"
    ],
    "env": {
      "ZEHOS_QEMU_SMP": "1"
    },
    "timeout": 1800,
    "note": "SMP_PROBE (alle Schritte, ISO mit ZehOSSmpProbe=true)"
  },
  {
    "name": "1-kvm-isolation",
    "cmd": [
      "{python}",
      "scripts/test-isolation-probe.py",
      "--iso",
      "{isoisol}",
      "--accel",
      "kvm",
      "--runs",
      "2"
    ],
    "env": {
      "ZEHOS_QEMU_SMP": "1"
    },
    "timeout": 1800,
    "note": "Isolation positiv, 2 Laeufe"
  },
  {
    "name": "1-kvm-shutdown",
    "cmd": [
      "{python}",
      "scripts/test-desktop-guest.py",
      "--iso",
      "{isorec}",
      "--accel",
      "kvm",
      "--recovery",
      "--power"
    ],
    "env": {
      "ZEHOS_QEMU_SMP": "1"
    },
    "timeout": 1800,
    "note": "Recovery-ISO: reboot und shutdown"
  },
  {
    "name": "1-kvm-doomquick-remove",
