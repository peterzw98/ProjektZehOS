[
  {
    "name": "doom-full-leer",
    "cmd": [
      "{python}",
      "scripts/test-wasm-doom-desktop.py",
      "--iso",
      "{isowasm}",
      "--repo",
      "{fx}/repo",
      "--key",
      "{fx}/key/private.pem",
      "--tls",
      "{fx}/tls",
      "--wasi-sdk",
      "{fx}/sdk/wasi-sdk-25.0-x86_64-linux",
      "--scenario",
      "full",
      "--accel",
      "kvm"
    ],
    "repeat": 3,
    "timeout": 3600,
    "note": "Doom full, KVM, ohne Snapshot (kvm); 3 Wiederholungen"
  },
