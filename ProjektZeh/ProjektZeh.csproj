<Project Sdk="Cosmos.Sdk/3.0.94">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <DefineConstants Condition="'$(ZehOSInstaller)' == 'true'">$(DefineConstants);ZEHOS_INSTALLER</DefineConstants>
    <CosmosKernelClass>ProjektZeh.Kernel</CosmosKernelClass>
    <DefineConstants Condition="'$(ZehOSRecovery)' == 'true'">$(DefineConstants);ZEHOS_RECOVERY</DefineConstants>
    <DefineConstants Condition="'$(ZehOSThreadProbe)' == 'true'">$(DefineConstants);ZEHOS_THREAD_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityFileProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE;ZEHOS_SECURITY_FILE_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityRecovery)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_RECOVERY;ZEHOS_RECOVERY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Cosmos.Kernel" Version="3.0.94" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.94" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZehOSInstaller)' == 'true'">
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" LogicalName="ZehOS.Payload.Kernel" />
    <EmbeddedResource Include="$(ZehOSPayloadDir)/BOOTX64.EFI" LogicalName="ZehOS.Payload.Efi" />
  </ItemGroup>

  <UsingTask TaskName="InvertInstallerPayload" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] bytes = System.IO.File.ReadAllBytes(Source);
        for (int i = 0; i < bytes.Length; i++) bytes[i] ^= 0xff;
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        System.IO.File.WriteAllBytes(Destination, bytes);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateInstallerPayload" BeforeTargets="PrepareForBuild" Condition="'$(ZehOSInstaller)' == 'true'">
    <Error Condition="'$(ZehOSPayloadDir)' == ''" Text="ZehOSInstaller benoetigt -p:ZehOSPayloadDir mit normalem ProjektZeh.elf und BOOTX64.EFI." />
    <Error Condition="!Exists('$(ZehOSPayloadDir)/ProjektZeh.elf') Or !Exists('$(ZehOSPayloadDir)/BOOTX64.EFI')" Text="Die Installer-Payload ist unvollstaendig." />
  </Target>
  <!-- Limine darf die Requests des eingebetteten Kernels nicht als eigene Installer-Requests erkennen. -->
  <Target Name="PrepareInstallerKernelPayload" BeforeTargets="PrepareResources" DependsOnTargets="ValidateInstallerPayload" Condition="'$(ZehOSInstaller)' == 'true'"
          Inputs="$(ZehOSPayloadDir)/ProjektZeh.elf" Outputs="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf">
    <InvertInstallerPayload Source="$(ZehOSPayloadDir)/ProjektZeh.elf" Destination="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" />
  </Target>
</Project>
