<Project Sdk="Cosmos.Sdk/3.0.94" TreatAsLocalProperty="DefineConstants">

  <!-- cosmos build setzt DefineConstants global; lokale Ergaenzungen wie ZEHOS_WASM muessen erhalten bleiben. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <Version Condition="'$(Version)' == ''">0.3.0</Version>
    <DefineConstants Condition="'$(ZehOSInstaller)' == 'true'">$(DefineConstants);ZEHOS_INSTALLER</DefineConstants>
    <DefineConstants Condition="'$(ZehOSNetworkProbe)' == 'true' and '$(ZehOSNetworkProbeCaPath)' != ''">$(DefineConstants);ZEHOS_NETWORK_TLS_PROBE</DefineConstants>
    <CosmosKernelClass>ProjektZeh.Kernel</CosmosKernelClass>
    <DefineConstants Condition="'$(ZehOSNetworkProbe)' == 'true'">$(DefineConstants);ZEHOS_NETWORK_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSRecovery)' == 'true'">$(DefineConstants);ZEHOS_RECOVERY</DefineConstants>
    <DefineConstants Condition="'$(ZehOSThreadProbe)' == 'true'">$(DefineConstants);ZEHOS_THREAD_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityFileProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE;ZEHOS_SECURITY_FILE_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityRecovery)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_RECOVERY;ZEHOS_RECOVERY</DefineConstants>
    <ZehOSWasm Condition="'$(ZehOSWasm)' == ''">true</ZehOSWasm>
    <ZehOSWasm Condition="'$(ZehOSWasmProbe)' == 'true'">true</ZehOSWasm>
    <DefineConstants Condition="'$(ZehOSWasm)' == 'true'">$(DefineConstants);ZEHOS_WASM</DefineConstants>
    <DefineConstants Condition="'$(ZehOSWasmProbe)' == 'true'">$(DefineConstants);ZEHOS_WASM_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- wasm3 und seine freistehende C-Laufzeit gehoeren zum normalen Kernelbuild. -->
  <PropertyGroup Condition="'$(ZehOSWasm)' == 'true'">
    <!-- Cosmos-3.0.94-Standardflags plus nativem wasm3-Stackbudget (7 MiB): Wasm laeuft auf einem Thread mit
         8 MiB Stack (WasmRuntime.ThreadStackBytes); Rekursion endet so als Wasm-Trap statt im Triple Fault. -->
    <CCCompilerFlags>-O2 -fno-stack-protector -nostdinc -fno-builtin -Dd_m3MaxNativeStack=7340032</CCCompilerFlags>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZehOSWasm)' == 'true'">
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wasm3/source/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Wasm/libc/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Wasm/host/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)Native/Wasm/libc/include/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wasm3/source/" />
  </ItemGroup>

  <ItemGroup>
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Acpi/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Cosmos.Kernel" Version="3.0.94" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.94" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ThirdParty/CosmosHttp/cacert.pem" LogicalName="ZehOS.TlsRoots" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZehOSNetworkProbe)' == 'true' and '$(ZehOSNetworkProbeCaPath)' != ''">
    <EmbeddedResource Include="$(ZehOSNetworkProbeCaPath)" LogicalName="ZehOS.NetworkProbeCa" />
  </ItemGroup>
  <!-- Oeffentlicher Ed25519-Paketschluessel (Base64-Textdatei); ohne ihn bleibt pkg deaktiviert. Standard ist der
       eingecheckte Herausgeberschluessel, sobald er existiert; -p:ZehOSPackageKeyPath ersetzt ihn, etwa fuer Tests. -->
  <PropertyGroup Condition="'$(ZehOSPackageKeyPath)' == '' and Exists('Packages/package-key.pub')">
    <ZehOSPackageKeyPath>Packages/package-key.pub</ZehOSPackageKeyPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZehOSPackageKeyPath)' != ''">
    <EmbeddedResource Include="$(ZehOSPackageKeyPath)" LogicalName="ZehOS.PackageKey" />
  </ItemGroup>
  <!-- Nur fuer Tests mit lokalem HTTPS-Repository; ergaenzt die normalen TLS-Wurzeln fuer Paketdownloads. -->
  <ItemGroup Condition="'$(ZehOSPackageTestCaPath)' != ''">
    <EmbeddedResource Include="$(ZehOSPackageTestCaPath)" LogicalName="ZehOS.PackageTestCa" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZehOSInstaller)' == 'true'">
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" LogicalName="ZehOS.Payload.Kernel" />
    <EmbeddedResource Include="$(ZehOSPayloadDir)/BOOTX64.EFI" LogicalName="ZehOS.Payload.Efi" />
  </ItemGroup>

  <UsingTask TaskName="InvertInstallerPayload" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] bytes = System.IO.File.ReadAllBytes(Source);
        for (int i = 0; i < bytes.Length; i++) bytes[i] ^= 0xff;
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        System.IO.File.WriteAllBytes(Destination, bytes);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateInstallerPayload" BeforeTargets="PrepareForBuild" Condition="'$(ZehOSInstaller)' == 'true'">
    <Error Condition="'$(ZehOSPayloadDir)' == ''" Text="ZehOSInstaller benoetigt -p:ZehOSPayloadDir mit normalem ProjektZeh.elf und BOOTX64.EFI." />
    <Error Condition="!Exists('$(ZehOSPayloadDir)/ProjektZeh.elf') Or !Exists('$(ZehOSPayloadDir)/BOOTX64.EFI')" Text="Die Installer-Payload ist unvollstaendig." />
  </Target>
  <!-- Limine darf die Requests des eingebetteten Kernels nicht als eigene Installer-Requests erkennen.
       Ohne Inputs/Outputs: Zeitstempel einer neuen Payload koennen aelter sein und wuerden sonst einen alten Kernel einbetten. -->
  <Target Name="PrepareInstallerKernelPayload" AfterTargets="ValidateInstallerPayload" Condition="'$(ZehOSInstaller)' == 'true'">
    <InvertInstallerPayload Source="$(ZehOSPayloadDir)/ProjektZeh.elf" Destination="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" />
    <ItemGroup>
      <FileWrites Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" />
    </ItemGroup>
  </Target>
</Project>
