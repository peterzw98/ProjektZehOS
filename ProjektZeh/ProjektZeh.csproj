<Project Sdk="Cosmos.Sdk" TreatAsLocalProperty="DefineConstants">

  <!-- cosmos build setzt DefineConstants global; lokale Ergaenzungen wie ZEHOS_WASM muessen erhalten bleiben. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PathMap Condition="'$(PathMap)' == ''">$(MSBuildProjectDirectory)=/zehos</PathMap>
    <!-- Version = Prefix.(PatchBase + Merges auf master seit der letzten Aenderung dieser beiden Elementzeilen), Ziel
         ZehOSVersionFromGit. Jede Aenderung einer der beiden Zeilen setzt den Zaehler zurueck: PatchBase dann auf den aktuellen
         Patch + 1 (oder 0 mit neuem Prefix, etwa 0.6). PRs aendern keine Version; -p:Version (Release) gewinnt. -->
    <ZehOSVersionPrefix>0.6</ZehOSVersionPrefix>
    <ZehOSPatchBase>0</ZehOSPatchBase>
    <!-- Vor den SDK-Targets ausgewertet: nicht leer nur bei -p:Version von aussen (das SDK setzt sonst spaeter 1.0.0). -->
    <ZehOSVersionFromBuild>$(Version)</ZehOSVersionFromBuild>
    <DefineConstants Condition="'$(ZehOSInstaller)' == 'true'">$(DefineConstants);ZEHOS_INSTALLER</DefineConstants>
    <!-- GPT-Installer (Spec 7a-S4) nur in Testbuilds bis zum Go von Paket 4.0 und gruenen Gasttests G1-G7. -->
    <DefineConstants Condition="'$(ZehOSGptInstaller)' == 'true'">$(DefineConstants);ZEHOS_GPT_INSTALLER</DefineConstants>
    <!-- Nur Gastabnahme: Setup-Ausgaben werden seriell fuer den Test gespiegelt. -->
    <DefineConstants Condition="'$(ZehOSGptGuestProbe)' == 'true'">$(DefineConstants);ZEHOS_GPT_GUEST_PROBE</DefineConstants>
    <!-- Nur fuer den G8-Abbruchtest: vor dem ESP-Marker bei 96 Prozent warten. -->
    <DefineConstants Condition="'$(ZehOSGptInstaller)' == 'true' and '$(ZehOSGptG8Probe)' == 'true'">$(DefineConstants);ZEHOS_GPT_G8_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSNetworkProbe)' == 'true' and '$(ZehOSNetworkProbeCaPath)' != ''">$(DefineConstants);ZEHOS_NETWORK_TLS_PROBE</DefineConstants>
    <CosmosKernelClass>ProjektZeh.Kernel</CosmosKernelClass>
    <DefineConstants Condition="'$(ZehOSNetworkProbe)' == 'true'">$(DefineConstants);ZEHOS_NETWORK_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSRecovery)' == 'true'">$(DefineConstants);ZEHOS_RECOVERY</DefineConstants>
    <DefineConstants Condition="'$(ZehOSThreadProbe)' == 'true'">$(DefineConstants);ZEHOS_THREAD_PROBE</DefineConstants>
    <!-- Gastprobe 12.4-I1: CPU-Ausnahmen im Wasm-Worker; Negative haelt zum Schluss im Probe-Thread an. -->
    <DefineConstants Condition="'$(ZehOSIsolationProbe)' == 'true'">$(DefineConstants);ZEHOS_ISOLATION_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSIsolationProbeNegative)' == 'true'">$(DefineConstants);ZEHOS_ISOLATION_PROBE;ZEHOS_ISOLATION_PROBE_NEGATIVE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSIsolationProbeNmi)' == 'true'">$(DefineConstants);ZEHOS_ISOLATION_PROBE;ZEHOS_ISOLATION_PROBE_NMI</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSimdProbe)' == 'true'">$(DefineConstants);ZEHOS_SIMD_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSStorageProbe)' == 'true'">$(DefineConstants);ZEHOS_STORAGE_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSRootProfile)' == 'true'">$(DefineConstants);ZEHOS_ROOT_PROFILE</DefineConstants>
    <!-- Etappe 4.5: system migrate (Legacy -> Root) samt Quellsperre aller Schreiber; bis zum Gast-Go nur mit diesem Flag. -->
    <DefineConstants Condition="'$(ZehOSRootMigration)' == 'true'">$(DefineConstants);ZEHOS_ROOT_MIGRATION</DefineConstants>
    <!-- Nur 7b-Gasttest P4: Shellbefehl powerfault laesst einen Punkt der Energieaktion einmal scheitern; nie im Release. -->
    <DefineConstants Condition="'$(ZehOSRootProfile)' == 'true' and '$(ZehOSPowerFaultProbe)' == 'true'">$(DefineConstants);ZEHOS_POWER_FAULT_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityFileProbe)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_PROBE;ZEHOS_SECURITY_FILE_PROBE</DefineConstants>
    <DefineConstants Condition="'$(ZehOSSecurityRecovery)' == 'true'">$(DefineConstants);ZEHOS_SECURITY_RECOVERY;ZEHOS_RECOVERY</DefineConstants>
    <ZehOSWasm Condition="'$(ZehOSWasm)' == ''">true</ZehOSWasm>
    <ZehOSWasm Condition="'$(ZehOSWasmProbe)' == 'true'">true</ZehOSWasm>
    <DefineConstants Condition="'$(ZehOSWasm)' == 'true'">$(DefineConstants);ZEHOS_WASM</DefineConstants>
    <DefineConstants Condition="'$(ZehOSWasmProbe)' == 'true'">$(DefineConstants);ZEHOS_WASM_PROBE</DefineConstants>
    <!-- WAMR-AOT-Lader (Plan 5c, Etappe D) vorerst nur auf Wunsch: AOT bleibt bis Etappe F aus (Schalter wasmaot,
         Standard aus); ohne diesen Schalter waehlt WasmGameApp immer wasm3. Er braucht wasm3s freistehende C-Laufzeit; die AOT-Gastprobe schaltet ihn ein. -->
    <ZehOSWasmAot Condition="'$(ZehOSAotProbe)' == 'true'">true</ZehOSWasmAot>
    <ZehOSWasm Condition="'$(ZehOSWasmAot)' == 'true'">true</ZehOSWasm>
    <DefineConstants Condition="'$(ZehOSWasmAot)' == 'true'">$(DefineConstants);ZEHOS_WASM_AOT</DefineConstants>
    <DefineConstants Condition="'$(ZehOSAotProbe)' == 'true'">$(DefineConstants);ZEHOS_AOT_PROBE</DefineConstants>
  </PropertyGroup>

  <!-- wasm3 und seine freistehende C-Laufzeit gehoeren zum normalen Kernelbuild. -->
  <PropertyGroup Condition="'$(ZehOSWasm)' == 'true'">
    <!-- Cosmos-Standardflags (3.0.94 bis 3.0.97 gleich) plus nativem wasm3-Stackbudget (7 MiB): Wasm laeuft auf einem Thread mit
         8 MiB Stack (WasmRuntime.ThreadStackBytes); Rekursion endet so als Wasm-Trap statt im Triple Fault. -->
    <CCCompilerFlags>-O2 -fno-stack-protector -nostdinc -fno-builtin -Dd_m3MaxNativeStack=7340032</CCCompilerFlags>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZehOSWasm)' == 'true'">
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wasm3/source/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Wasm/libc/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Wasm/host/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)Native/Wasm/libc/include/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wasm3/source/" />
  </ItemGroup>
  <!-- WAMR 2.4.5 nur als AOT-Lader (Plan 5c, Etappe B2): kein Interpreter, kein JIT, keine WASI-libc, keine Threads,
       explizite statt hardwaregestuetzter Bereichspruefung. Die Schalter gelten fuer alle C-Quellen, betreffen aber nur WAMR
       und die WAMR-Bindung zehos_host_wamr.c (ZEHOS_WASM_AOT).
       Bulk-Memory und Referenztypen bleiben an, weil wasi-sdk 25 sie standardmaessig erzeugt; sonst lehnt der Lader jedes Paket ab. -->
  <PropertyGroup Condition="'$(ZehOSWasmAot)' == 'true'">
    <CCCompilerFlags>$(CCCompilerFlags) -DZEHOS_WASM_AOT -DBH_PLATFORM_ZEHOS -DBUILD_TARGET_X86_64 -DBH_MALLOC=wasm_runtime_malloc -DBH_FREE=wasm_runtime_free -DWASM_ENABLE_AOT=1 -DWASM_ENABLE_INTERP=0 -DWASM_ENABLE_FAST_INTERP=0 -DWASM_ENABLE_JIT=0 -DWASM_ENABLE_FAST_JIT=0 -DWASM_ENABLE_LIBC_BUILTIN=0 -DWASM_ENABLE_LIBC_WASI=0 -DWASM_ENABLE_THREAD_MGR=0 -DWASM_ENABLE_SHARED_MEMORY=0 -DWASM_ENABLE_MULTI_MODULE=0 -DWASM_ENABLE_SIMD=0 -DWASM_ENABLE_BULK_MEMORY=1 -DWASM_ENABLE_REF_TYPES=1 -DWASM_ENABLE_AOT_INTRINSICS=1 -DWASM_ENABLE_QUICK_AOT_ENTRY=1 -DWASM_ENABLE_SHRUNK_MEMORY=1 -DWASM_ENABLE_MINI_LOADER=0 -DWASM_ENABLE_EXTENDED_CONST_EXPR=0 -DWASM_DISABLE_HW_BOUND_CHECK=1 -DWASM_DISABLE_STACK_HW_BOUND_CHECK=1 -DWASM_DISABLE_WAKEUP_BLOCKING_OP=0 -DWASM_DISABLE_WRITE_GS_BASE=1 -DWASM_GLOBAL_HEAP_SIZE=10485760 -Dstatic_assert=_Static_assert</CCCompilerFlags>
  </PropertyGroup>
  <!-- Nur fuer die SIMD-Probe: ILC-Befehlssatz ausdruecklich vorgeben (z. B. x86-64-v3, native). Ohne Angabe bleibt der Cosmos-Standard. -->
  <ItemGroup Condition="'$(ZehOSSimdProbe)' == 'true' and '$(ZehOSSimdInstructionSet)' != ''">
    <IlcArg Include="--instruction-set:$(ZehOSSimdInstructionSet)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZehOSAotProbe)' == 'true'">
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/AotProbe/" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZehOSWasmAot)' == 'true'">
    <GCCProject Include="$(MSBuildThisFileDirectory)Native/Wasm/wamr-platform/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/aot/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/aot/arch/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/common/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/utils/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/mem-alloc/" />
    <GCCProject Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/mem-alloc/ems/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)Native/Wasm/wamr-platform/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/platform/include/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/utils/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/shared/mem-alloc/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/include/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/common/" />
    <GCCIncludePath Include="$(MSBuildThisFileDirectory)ThirdParty/wamr/core/iwasm/aot/" />
  </ItemGroup>

  <!-- Native Assertion-Texte duerfen keine lokalen Quell- und Paketpfade enthalten. -->
  <Target Name="MapNativeSourcePaths" BeforeTargets="BuildCC">
    <PropertyGroup>
      <CCCompilerFlags Condition="'$(CCCompilerFlags)' == ''">-O2 -fno-stack-protector -nostdinc -fno-builtin</CCCompilerFlags>
      <CCCompilerFlags>$(CCCompilerFlags) -ffile-prefix-map=&quot;$(NuGetPackageRoot)=/nuget/&quot; -ffile-prefix-map=&quot;$(MSBuildProjectDirectory)=/zehos&quot;</CCCompilerFlags>
    </PropertyGroup>
  </Target>

  <!-- Cosmos.Build.CC 3.0.97 (CCBuildTask) benennt Objektdateien nur nach dem Inhalt der .c-Datei und ueberspringt
       vorhandene. Geaenderte Header oder C-Flags (etwa d_m3MaxNativeStack, ZehOSAotProbe) liessen so alte Objekte in
       cobj/ stehen, bis zu "undefined symbol" beim Linken. Ein Stempel aus Flags, Include-Pfaden und dem Inhalt aller
       eigenen Header leert cobj/, sobald sich davon etwas aendert; danach uebersetzt Cosmos alle C-Dateien neu.
       Bewusst grob: auch Header, die der jeweilige Build nicht einbindet (etwa WAMR ohne ZehOSAotProbe), loesen das aus. -->
  <Target Name="InvalidateStaleCObjects" BeforeTargets="BuildCC" DependsOnTargets="MapNativeSourcePaths;FindCSourceFilesForCC">
    <PropertyGroup>
      <ZehOSCObjDir>$(IntermediateOutputPath)cosmos/cobj/</ZehOSCObjDir>
      <ZehOSCStampFile>$(IntermediateOutputPath)cosmos/cobj.stamp</ZehOSCStampFile>
    </PropertyGroup>
    <ItemGroup>
      <ZehOSCHeader Include="Native/**/*.h;ThirdParty/**/*.h" />
    </ItemGroup>
    <GetFileHash Files="@(ZehOSCHeader)">
      <Output TaskParameter="Items" ItemName="ZehOSCHeaderHash" />
    </GetFileHash>
    <Hash ItemsToHash="$(CCCompilerFlags);$(TargetArchitecture);@(GCCIncludePath);@(GCCProject->'%(FullPath)');@(ZehOSCHeaderHash->'%(Identity)=%(FileHash)')">
      <Output TaskParameter="HashResult" PropertyName="ZehOSCStamp" />
    </Hash>
    <ReadLinesFromFile File="$(ZehOSCStampFile)" Condition="Exists('$(ZehOSCStampFile)')">
      <Output TaskParameter="Lines" PropertyName="ZehOSCStampOld" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'$(ZehOSCStampOld)' != '$(ZehOSCStamp)'">
      <ZehOSStaleCObject Include="$(ZehOSCObjDir)*.o;$(ZehOSCObjDir)*.obj" />
    </ItemGroup>
    <Message Text="[CC] Header oder C-Flags geaendert: @(ZehOSStaleCObject->Count()) Objektdateien verworfen" Importance="High" Condition="'@(ZehOSStaleCObject)' != ''" />
    <Delete Files="@(ZehOSStaleCObject)" />
    <MakeDir Directories="$(IntermediateOutputPath)cosmos/" />
    <WriteLinesToFile File="$(ZehOSCStampFile)" Lines="$(ZehOSCStamp)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Unter Unix ruft das SDK `cosmos.patcher` aus dem PATH; ein globales Werkzeug anderer Version (etwa das Upstream-3.0.97)
       wuerde die selbst gebauten Pakete still mit fremdem Patcher verarbeiten. Daher vor dem Patchen die Version abgleichen. -->
  <Target Name="ZehOSCheckPatcherVersion" BeforeTargets="SetupPatcher" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="cosmos.patcher --version" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="ZehOSPatcherExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="ZehOSPatcherVersionLine" />
    </Exec>
    <Error Condition="'$(ZehOSPatcherExitCode)' != '0'"
           Text="cosmos.patcher ist nicht aufrufbar (Exit $(ZehOSPatcherExitCode)). Erwartet Version $(ZehOSCosmosVersion): scripts/build-cosmos.sh ausfuehren und .tools/cosmos-tools/$(ZehOSCosmosVersion)/ in den PATH legen (oder --global)." />
    <PropertyGroup>
      <ZehOSPatcherVersion>$(ZehOSPatcherVersionLine.Split('+')[0].Trim())</ZehOSPatcherVersion>
    </PropertyGroup>
    <Error Condition="'$(ZehOSPatcherVersion)' != '$(ZehOSCosmosVersion)'"
           Text="cosmos.patcher im PATH hat Version '$(ZehOSPatcherVersion)', erwartet '$(ZehOSCosmosVersion)'. Passendes Werkzeug installieren: scripts/build-cosmos.sh (liegt unter .tools/cosmos-tools/$(ZehOSCosmosVersion)/) und dessen Ordner in den PATH legen." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Cosmos.Kernel" Version="[$(ZehOSCosmosVersion)]" />
    <PackageReference Include="Cosmos.Kernel.System" Version="[$(ZehOSCosmosVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ThirdParty/CosmosHttp/cacert.pem" LogicalName="ZehOS.TlsRoots" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZehOSNetworkProbe)' == 'true' and '$(ZehOSNetworkProbeCaPath)' != ''">
    <EmbeddedResource Include="$(ZehOSNetworkProbeCaPath)" LogicalName="ZehOS.NetworkProbeCa" />
  </ItemGroup>
  <!-- Oeffentlicher Ed25519-Paketschluessel (Base64-Textdatei); ohne ihn bleibt pkg deaktiviert. Standard ist der
       eingecheckte Herausgeberschluessel, sobald er existiert; -p:ZehOSPackageKeyPath ersetzt ihn, etwa fuer Tests. -->
  <PropertyGroup Condition="'$(ZehOSPackageKeyPath)' == '' and Exists('Packages/package-key.pub')">
    <ZehOSPackageKeyPath>Packages/package-key.pub</ZehOSPackageKeyPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ZehOSPackageKeyPath)' != ''">
    <EmbeddedResource Include="$(ZehOSPackageKeyPath)" LogicalName="ZehOS.PackageKey" />
  </ItemGroup>
  <!-- Ausschliesslich fuer lokale Update-Tests: ersetzt das Produktionsvertrauen, ohne Rueckfall. -->
  <PropertyGroup Condition="'$(ZehOSUpdateTestKeyPath)' != ''">
    <DefineConstants>$(DefineConstants);ZEHOS_UPDATE_TESTKEY</DefineConstants>
  </PropertyGroup>
  <!-- Erst nach der Versionsbestimmung; GetAssemblyVersion uebernimmt einen gesetzten Wert unveraendert. -->
  <Target Name="ZehOSUpdateTestKeyVersion" DependsOnTargets="ZehOSVersionFromGit" BeforeTargets="GetAssemblyVersion"
          Condition="'$(ZehOSUpdateTestKeyPath)' != ''">
    <PropertyGroup>
      <InformationalVersion>$(Version)+update-testkey</InformationalVersion>
    </PropertyGroup>
  </Target>
  <ItemGroup Condition="'$(ZehOSUpdateTestKeyPath)' != ''">
    <EmbeddedResource Include="$(ZehOSUpdateTestKeyPath)" LogicalName="ZehOS.UpdateTestKey" />
  </ItemGroup>
  <!-- Nur fuer Tests mit lokalem HTTPS-Repository; ergaenzt die normalen TLS-Wurzeln fuer Paketdownloads. -->
  <ItemGroup Condition="'$(ZehOSPackageTestCaPath)' != ''">
    <EmbeddedResource Include="$(ZehOSPackageTestCaPath)" LogicalName="ZehOS.PackageTestCa" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZehOSInstaller)' == 'true'">
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" LogicalName="ZehOS.Payload.Kernel" />
    <EmbeddedResource Include="$(ZehOSPayloadDir)/BOOTX64.EFI" LogicalName="ZehOS.Payload.Efi" />
  </ItemGroup>

  <UsingTask TaskName="InvertInstallerPayload" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] bytes = System.IO.File.ReadAllBytes(Source);
        for (int i = 0; i < bytes.Length; i++) bytes[i] ^= 0xff;
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        System.IO.File.WriteAllBytes(Destination, bytes);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateInstallerPayload" BeforeTargets="PrepareForBuild" Condition="'$(ZehOSInstaller)' == 'true'">
    <Error Condition="'$(ZehOSPayloadDir)' == ''" Text="ZehOSInstaller benoetigt -p:ZehOSPayloadDir mit normalem ProjektZeh.elf und BOOTX64.EFI." />
    <Error Condition="!Exists('$(ZehOSPayloadDir)/ProjektZeh.elf') Or !Exists('$(ZehOSPayloadDir)/BOOTX64.EFI')" Text="Die Installer-Payload ist unvollstaendig." />
  </Target>
  <!-- Limine darf die Requests des eingebetteten Kernels nicht als eigene Installer-Requests erkennen.
       Ohne Inputs/Outputs: Zeitstempel einer neuen Payload koennen aelter sein und wuerden sonst einen alten Kernel einbetten. -->
  <Target Name="PrepareInstallerKernelPayload" AfterTargets="ValidateInstallerPayload" Condition="'$(ZehOSInstaller)' == 'true'">
    <InvertInstallerPayload Source="$(ZehOSPayloadDir)/ProjektZeh.elf" Destination="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" />
    <ItemGroup>
      <FileWrites Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/installer/ProjektZeh.inverted.elf" />
    </ItemGroup>
  </Target>

  <!-- Auf master monoton: jeder Merge ist ein first-parent-Commit. Ohne vollstaendige Historie bricht der Bau ab, statt eine
       zu niedrige Version einzubauen (Paket-Mindestversionen und Updatevergleich wuerden sonst falsch entscheiden). Keine
       %-Platzhalter in den git-Aufrufen: Exec laeuft unter Windows ueber cmd. Das -G-Muster nennt die Elemente mit spitzen
       Klammern, damit nur die beiden Eigenschaftszeilen eine neue Basis setzen, nicht Kommentare oder dieses Ziel selbst. -->
  <Target Name="ZehOSVersionFromGit" BeforeTargets="GetAssemblyVersion" Condition="'$(ZehOSVersionFromBuild)' == ''">
    <Exec Command="git rev-parse --is-shallow-repository" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ZehOSGitShallow" />
      <Output TaskParameter="ExitCode" PropertyName="ZehOSGitExit" />
    </Exec>
    <Error Condition="'$(ZehOSGitExit)' != '0'" Text="ZehOS-Version: kein Git-Arbeitsbaum gefunden. Mit -p:Version=X.Y.Z bauen." />
    <Error Condition="'$(ZehOSGitShallow)' != 'false'"
           Text="ZehOS-Version: flacher Git-Klon. Vollstaendige Historie holen (git fetch --unshallow; CI: fetch-depth 0) oder -p:Version=X.Y.Z setzen." />
    <Exec Command="git log -1 --first-parent --diff-merges=first-parent -s --pretty=oneline -G &quot;&lt;ZehOSVersionPrefix&gt;|&lt;ZehOSPatchBase&gt;&quot; -- ProjektZeh.csproj"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ZehOSVersionBaseLine" />
    </Exec>
    <PropertyGroup>
      <ZehOSVersionBase>$(ZehOSVersionBaseLine.Split(' ')[0])</ZehOSVersionBase>
    </PropertyGroup>
    <Error Condition="'$(ZehOSVersionBase)' == ''"
           Text="ZehOS-Version: kein Commit mit den Versions-Elementzeilen in der first-parent-Historie (lokal nicht committet?)." />
    <Exec Command="git rev-list --count --first-parent $(ZehOSVersionBase)..HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="ZehOSVersionCommits" />
    </Exec>
    <PropertyGroup>
      <Version>$(ZehOSVersionPrefix).$([MSBuild]::Add($(ZehOSPatchBase), $(ZehOSVersionCommits)))</Version>
    </PropertyGroup>
    <Message Importance="high" Text="ZehOS-Version $(Version) (Basis $(ZehOSVersionBase), $(ZehOSVersionCommits) Commits danach)" />
  </Target>

  <!-- Branch-Bauten tragen keine eindeutige Nummer; Anzeige und Bootzeile nennen deshalb den Commit dazu. Als Konstante,
       weil Attribut-Reflexion im Cosmos-Kernel nicht belegt ist; ohne Git (nur mit -p:Version) steht dort "ohne-git". -->
  <Target Name="ZehOSBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short=10 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ZehOSCommit" />
      <Output TaskParameter="ExitCode" PropertyName="ZehOSCommitExit" />
    </Exec>
    <!-- Messbauten entstehen oft aus nicht committetem Stand; das soll in der Bootzeile sichtbar sein (Review pink). -->
    <Exec Command="git diff --quiet HEAD --" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(ZehOSCommitExit)' == '0'">
      <Output TaskParameter="ExitCode" PropertyName="ZehOSDirtyExit" />
    </Exec>
    <PropertyGroup>
      <ZehOSCommit Condition="'$(ZehOSCommitExit)' != '0' or '$(ZehOSCommit)' == ''">ohne-git</ZehOSCommit>
      <ZehOSCommit Condition="'$(ZehOSDirtyExit)' == '1'">$(ZehOSCommit)-dirty</ZehOSCommit>
      <ZehOSBuildInfoFile>$(IntermediateOutputPath)ZehOSBuildInfo.g.cs</ZehOSBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(ZehOSBuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace ProjektZeh%3B;internal static class BuildInfo { internal const string Commit = &quot;$(ZehOSCommit)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(ZehOSBuildInfoFile)" />
      <FileWrites Include="$(ZehOSBuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
