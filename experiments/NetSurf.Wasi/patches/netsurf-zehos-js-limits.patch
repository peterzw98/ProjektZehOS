@@ -40,6 +40,24 @@ typedef struct window_schedule_s {
 	bool running;
 } window_schedule_t;
 
+/* ZehOS: Obergrenze offener Timer je Fenster gegen eine Flut von
+ * setTimeout/setInterval; weitere Aufrufe liefern undefined. */
+#define ZEHOS_MAX_TIMERS 64
+
+static bool window_timer_limit_reached(window_private_t *window)
+{
+	window_schedule_t *sched = window->schedule_ring;
+	size_t count = 0;
+
+	if (sched != NULL) {
+		do {
+			count++;
+			sched = sched->r_next;
+		} while (sched != window->schedule_ring);
+	}
+	return count >= ZEHOS_MAX_TIMERS;
+}
