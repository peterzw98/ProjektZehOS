+/* ZehOS: gehaltene Maustaste nach Fokusverlust beenden, ohne einen Klick auszuloesen */
+static void fb_cancel_pointer(void)
+{
+	/* Unabhaengig vom Zustand: eine zweite Maustaste setzt ihn waehrend eines Ziehens auf PRESSED zurueck. */
+	if (gui_drag.grabbed_pointer) {
+		fbtk_tgrab_pointer(gui_drag.widget);
+		gui_drag.grabbed_pointer = false;
+	}
+	if (gui_drag.gw != NULL) {
+		browser_window_mouse_track(gui_drag.gw->bw, 0,
+				gui_drag.x, gui_drag.y);
+		gui_drag.gw = NULL;
+	}
+	gui_drag.state = GUI_DRAG_NONE;
+
+	/* Rollbalken greifen selbst; ihr Ziehen endet erst mit einem Loslassen */
+	fbtk_cancel_grab(fbtk);
+}
