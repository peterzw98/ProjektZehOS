 /* exported function documented in fbtk.h */
+void
+fbtk_cancel_grab(fbtk_widget_t *widget)
+{
+	fbtk_widget_t *root = fbtk_get_root_widget(widget);
+	fbtk_widget_t *grabbed = root->u.root.grabbed;
+	nsfb_event_t event;
+
+	if (grabbed == NULL)
+		return;
+
+	/* Nur Rollbalken beenden ihr Ziehen mit einem Loslassen; bei anderen Widgets waere es ein Klick. */
+	if ((grabbed->type == FB_WIDGET_TYPE_HSCROLL) ||
+	    (grabbed->type == FB_WIDGET_TYPE_VSCROLL)) {
+		event.type = NSFB_EVENT_KEY_UP;
+		event.value.keycode = NSFB_KEY_MOUSE_1;
+		fbtk_post_callback(grabbed, FBTK_CBT_CLICK, &event, 0, 0);
+	}
+
+	root->u.root.grabbed = NULL;
+}
