+/**
+ * Pointer-Grab ohne Klick beenden (ZehOS-Fokusverlust).
+ *
+ * Ein greifender Rollbalken erhaelt ein Loslassen von Maustaste 1, das dort nur das Ziehen beendet; andere
+ * Widgets erhalten nichts. Der Grab ist danach in jedem Fall aufgehoben.
+ */
+void fbtk_cancel_grab(fbtk_widget_t *widget);
