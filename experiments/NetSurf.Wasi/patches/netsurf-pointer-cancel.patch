+/**
+ * Pointer-Grab ohne Klick beenden (ZehOS-Fokusverlust).
+ *
+ * Ein noch greifendes Widget (etwa ein gezogener Rollbalken) erhaelt ein Loslassen von Maustaste 1, das bei
+ * Rollbalken nur das Ziehen beendet. Bleibt der Grab danach bestehen, wird er aufgehoben.
+ */
+void fbtk_cancel_grab(fbtk_widget_t *widget);
