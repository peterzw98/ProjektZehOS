+/**
+ * ZehOS: true, wenn p ein Secure-Cookie mit Domain, Pfad und Name von c hält.
+ */
+static bool
+urldb_has_secure_cookie(const struct path_data *p,
+			const struct cookie_internal_data *c)
+{
+	const struct cookie_internal_data *d;
+
+	for (d = p->cookies; d; d = d->next) {
+		if (d->secure && !strcmp(d->domain, c->domain) &&
+		    !strcmp(d->path, c->path) && !strcmp(d->name, c->name))
+			return true;
+	}
+	return false;
+}
