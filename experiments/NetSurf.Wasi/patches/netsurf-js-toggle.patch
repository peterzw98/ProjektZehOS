+/* ZehOS: JavaScript nur fuer diese Sitzung umschalten; der Wert wird nie gespeichert.
+ * Nur der fbtk-Tastenpfad ruft das auf, DOM-Ereignisse einer Seite erreichen ihn nicht. */
+static void
+fb_toggle_javascript(struct gui_window *gw)
+{
+	nsoption_set_bool(enable_javascript, !nsoption_bool(enable_javascript));
+	gui_window_set_status(gw, nsoption_bool(enable_javascript) ? "" : "JS aus");
+	/* Nach einer Formularsendung (auch nach deren Weiterleitung) nicht neu laden: das ginge als GET
+	 * an das Formularziel. Der Schalter gilt dann, wie waehrend eines Ladevorgangs, ab der naechsten Seite. */
+	if (!browser_window_current_is_post(gw->bw))
+		browser_window_reload(gw->bw, false);
+}
