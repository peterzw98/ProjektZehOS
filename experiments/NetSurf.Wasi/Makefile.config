# ZehOS-Konfiguration für NetSurf 3.11 als WASIp1-Modul. Das Build-Skript kopiert sie nach netsurf/Makefile.config.
# Ausgeschaltet ist, was WASIp1 nicht trägt (Sockets) oder erst später gebraucht wird.
override NETSURF_USE_CURL := NO
override NETSURF_USE_OPENSSL := NO
# Duktape ist eingebaut; JavaScript ist in NetSurf standardmäßig aus, res/Choices hält das ausdrücklich fest.
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_JPEG := NO
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_PNG := NO
override NETSURF_USE_WEBP := NO
override NETSURF_USE_NSSVG := NO
override NETSURF_USE_RSVG := NO
override NETSURF_USE_ROSPRITE := NO
# wasi-libc (musl) enthält iconv; LIBICONV_PLUG nutzt es statt einer eigenen libiconv.
override NETSURF_USE_LIBICONV_PLUG := YES
override NETSURF_FB_FONTLIB := internal
# mmap im file:-Fetcher und signal(SIGPIPE) beim Start; wasi-libc emuliert beides ohne Hostfunktionen.
CFLAGS += -D_WASI_EMULATED_MMAN -D_WASI_EMULATED_SIGNAL
LDFLAGS += -lwasi-emulated-mman -lwasi-emulated-signal
# Duktape wirft Fehler per setjmp/longjmp; build.py übersetzt das Ergebnis danach mit wasm-opt nach exnref.
# Der Standardstapel von 64 KiB läuft mit Duktape über.
CFLAGS += -mllvm -wasm-enable-sjlj
LDFLAGS += -lsetjmp -Wl,-z,stack-size=1048576
# Paketdateien liegen im freigegebenen Wurzelverzeichnis der App; Schriften sind eingebaut.
override NETSURF_FB_RESPATH := /res
