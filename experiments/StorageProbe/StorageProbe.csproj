<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hostprobe: formatiert ein Image mit dem Ext2Formatter aus Cosmos 3.0.97 (kein Kernelbuild). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CosmosLib>$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))cosmos.kernel.system/$(ZehOSCosmosVersion)/runtimes/linux-x64/lib/net10.0/</CosmosLib>
    <CosmosHal>$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))cosmos.kernel.hal/$(ZehOSCosmosVersion)/runtimes/linux-x64/lib/net10.0/</CosmosHal>
    <CosmosCore>$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))cosmos.kernel.core/$(ZehOSCosmosVersion)/runtimes/linux-x64/lib/net10.0/</CosmosCore>
  </PropertyGroup>
  <!-- Nur die Assemblies laden, keine Cosmos-Build-Props importieren: PackageDownload holt die Pakete ohne Kernel-Restore. -->
  <ItemGroup>
    <PackageDownload Include="Cosmos.Kernel.System" Version="[$(ZehOSCosmosVersion)]" />
    <PackageDownload Include="Cosmos.Kernel.HAL" Version="[$(ZehOSCosmosVersion)]" />
    <PackageDownload Include="Cosmos.Kernel.Core" Version="[$(ZehOSCosmosVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Cosmos.Kernel.System" HintPath="$(CosmosLib)Cosmos.Kernel.System.dll" />
    <Reference Include="Cosmos.Kernel.HAL" HintPath="$(CosmosHal)Cosmos.Kernel.HAL.dll" />
    <Reference Include="Cosmos.Kernel.Core" HintPath="$(CosmosCore)Cosmos.Kernel.Core.dll" />
  </ItemGroup>
  <!-- Dieselbe korrigierte Formatterquelle wie im Kernel (Option formatter fixed). -->
  <ItemGroup>
    <Compile Include="../../ProjektZeh/Storage/Ext2/*.cs" Link="Ext2/%(Filename)%(Extension)" />
    <!-- 7a Schritt 2: produktiver GPT-Writer und Verify samt Abhaengigkeiten (Result-Typen, BlockReader). -->
    <Compile Include="../../ProjektZeh/Storage/Partitioning/*.cs" Link="Partitioning/%(Filename)%(Extension)" />
    <Compile Include="../../ProjektZeh/Storage/DiskEmptyCheck.cs" Link="Storage/DiskEmptyCheck.cs" />
    <Compile Include="../../ProjektZeh/Storage/StorageLock.cs" Link="Storage/StorageLock.cs" />
    <!-- Ext2/CosmosReadOnlyExt2FileSystem.cs braucht den schreibgeschuetzten VFS-Baustein aus Storage/. -->
    <Compile Include="../../ProjektZeh/Storage/CosmosReadOnlyVfs.cs" Link="Storage/CosmosReadOnlyVfs.cs" />
    <Compile Include="../../ProjektZeh/Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
