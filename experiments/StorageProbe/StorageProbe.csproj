<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hostprobe: formatiert ein Image mit dem Ext2Formatter aus Cosmos 3.0.97 (kein Kernelbuild). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CosmosLib>$(NuGetPackageRoot)cosmos.kernel.system/3.0.97/runtimes/linux-x64/lib/net10.0/</CosmosLib>
    <CosmosHal>$(NuGetPackageRoot)cosmos.kernel.hal/3.0.97/runtimes/linux-x64/lib/net10.0/</CosmosHal>
    <CosmosCore>$(NuGetPackageRoot)cosmos.kernel.core/3.0.97/runtimes/linux-x64/lib/net10.0/</CosmosCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Cosmos.Kernel.System" HintPath="$(CosmosLib)Cosmos.Kernel.System.dll" />
    <Reference Include="Cosmos.Kernel.HAL" HintPath="$(CosmosHal)Cosmos.Kernel.HAL.dll" />
    <Reference Include="Cosmos.Kernel.Core" HintPath="$(CosmosCore)Cosmos.Kernel.Core.dll" />
  </ItemGroup>
</Project>
