<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Selbst gebaute Cosmos-Pakete (scripts/build-cosmos.sh); nuget.org liefert den Rest. -->
    <add key="zehos-cosmos" value="deploy/cosmos/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Cosmos.* und _Cosmos.* kommen nur aus dem Feed (nie das offizielle 3.0.97 von nuget.org), alles andere nur von nuget.org.
       Der Kernel verlangt die Version exakt ([$(ZehOSCosmosVersion)], NU1603 ist ein Fehler); Hosttests laden kein Cosmos-Paket mehr. -->
  <packageSourceMapping>
    <packageSource key="zehos-cosmos">
      <package pattern="Cosmos.*" />
      <package pattern="_Cosmos.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
