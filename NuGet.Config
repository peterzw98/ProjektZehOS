<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Selbst gebaute Cosmos-Pakete (scripts/build-cosmos.sh); nuget.org liefert den Rest. -->
    <add key="zehos-cosmos" value="deploy/cosmos/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Cosmos-Pakete nur aus dem eigenen Feed: ein gleichnamiges Fremdpaket kann nicht einspringen. -->
  <packageSourceMapping>
    <packageSource key="zehos-cosmos">
      <package pattern="Cosmos.*" />
      <package pattern="_Cosmos.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
